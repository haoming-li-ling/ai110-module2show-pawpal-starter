classDiagram
    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() List~Task~
        +to_dict() dict
        +from_dict(data)$ Owner
        +save(path) void
        +load(path)$ Owner
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +get_pending_tasks() List~Task~
        +complete_task(task) Task
        +rename(new_name) void
        +to_dict() dict
        +from_dict(data)$ Pet
    }

    class Task {
        +String title
        +int duration_minutes
        +String priority
        +String preferred_time
        +String pet_name
        +bool completed
        +String recurrence
        +String due_date
        +mark_complete() Task
        +is_due(today) bool
        +to_dict() dict
        +from_dict(data)$ Task
    }

    class Scheduler {
        +Owner owner
        +List~Task~ plan
        +generate_daily_plan() List~Task~
        -_due_pending() List~Task~
        +sort_by_priority(tasks) List~Task~
        +sort_by_time(tasks) List~Task~
        +filter_tasks(pet_name, completed) List~Task~
        +detect_conflicts(tasks) List~String~
        +fits_in_time(tasks) List~Task~
        +mark_task_complete(task) Task
        +explain_plan() String
    }

    Owner "1" *-- "*" Pet : owns
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : schedules for
    Scheduler ..> Task : sorts, filters, plans
    Scheduler ..> Pet : mark_task_complete finds the pet
    Pet ..> Task : complete_task adds next occurrence
    Task ..> Task : mark_complete creates next occurrence
